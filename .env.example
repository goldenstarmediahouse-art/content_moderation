# ==============================================================================
# CHURCH FACEBOOK COMMENT MODERATION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Public Configuration (Safe for client & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Privileged Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Meta / Facebook Graph API Credentials (SERVER-SIDE ONLY)
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-facebook-app-secret
META_VERIFY_TOKEN=your-custom-webhook-verify-token-phrase

# Application Base URL for OAuth redirects & Webhook verification
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-Side Token Encryption Key (SERVER-SIDE ONLY)
# Must be a 32-byte hex string (64 hex characters) for AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OpenAI API Key for Moderation Engine (SERVER-SIDE ONLY)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
